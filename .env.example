# Copy this file to ".env" and fill in what you need.
# Never share .env or upload it anywhere: it holds your secret keys.

# Your website's address once it's live, e.g. https://www.eterna-tickets.com
# Used for the "back to the site" links after payment. Leave empty on your own computer.
PUBLIC_URL=

# Which payment provider to use: stripe, sumup or demo (test mode, only works locally).
# Leave empty to choose automatically: Stripe if its key is set, else SumUp, else test mode.
PAYMENT_PROVIDER=

# ---- Stripe -----------------------------------------------------------------
# dashboard.stripe.com -> Developers -> API keys. Use sk_test_... first, sk_live_... to go live.
STRIPE_SECRET_KEY=
# Signing secret (whsec_...) of the webhook pointing at https://YOUR-SITE/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# ---- SumUp ------------------------------------------------------------------
# me.sumup.com -> Settings -> For developers -> Toolkit -> API keys
SUMUP_API_KEY=
# Your SumUp merchant code (shown in your SumUp account / profile details)
SUMUP_MERCHANT_CODE=
# Set to 1 while you use a SumUp sandbox (test) account: shows a "test mode" note at checkout
SUMUP_SANDBOX=

# ---- Other ------------------------------------------------------------------
# Password for the bookings list at /admin (any username). Leave empty to switch that page off.
ADMIN_PASSWORD=
# Name shown in payment descriptions and bank statements' order text
BRAND_NAME=Eterna
# Port to listen on (most hosting services set this for you)
PORT=3000
# Set to 1 when the site runs behind a hosting proxy (Render, Railway, Fly.io, Nginx...)
TRUST_PROXY=
# Set to production on the live server (switches test mode off and enables HTTPS-only headers)
NODE_ENV=
